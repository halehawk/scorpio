#!/bin/bash
# run_sst_f_paired.sh — launch Fortran SST writer and reader concurrently.
# Configured by CMake; do not edit this .in template directly.
#
# Uses MPMD mode to run writer and reader as separate MPI jobs within a
# single mpirun invocation, so SST rendezvous occurs without extra setup.
#
# MPIEXEC       = @MPIEXEC@
# NUMPROC_FLAG  = @MPIEXEC_NUMPROC_FLAG@
# PREFLAGS      = @MPIEXEC_PREFLAGS@
# POSTFLAGS     = @MPIEXEC_POSTFLAGS@

WRITER="@CMAKE_CURRENT_BINARY_DIR@/pio_sst_writer_f"
READER="@CMAKE_CURRENT_BINARY_DIR@/pio_sst_reader_f"
MPIEXEC="@MPIEXEC@"
NUMPROC="@MPIEXEC_NUMPROC_FLAG@"
PREFLAGS="@MPIEXEC_PREFLAGS@"
POSTFLAGS="@MPIEXEC_POSTFLAGS@"
NPROCS=2

# MPMD: 2 ranks run the writer, 2 ranks run the reader, all in one mpirun
exec $MPIEXEC $NUMPROC $NPROCS $PREFLAGS $WRITER $POSTFLAGS \
    : $NUMPROC $NPROCS $PREFLAGS $READER $POSTFLAGS
